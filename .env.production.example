# ══════════════════════════════════════════════════════════
# Enterprise RAG Assistant — Production Environment Template
# Copy to .env and fill in real values before deploying.
# Generate SECRET_KEY with: openssl rand -hex 32
# ══════════════════════════════════════════════════════════

# ── Domain
DOMAIN=yourdomain.com

# ── LLM
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# ── Auth
SECRET_KEY=replace-with-openssl-rand-hex-32-output
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Postgres in production)
POSTGRES_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgresql://raguser:${POSTGRES_PASSWORD}@postgres:5432/ragdb

# ── Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── App
APP_ENV=production
LOG_LEVEL=INFO
PUBLIC_APP_URL=https://yourdomain.com
API_BASE_URL=https://yourdomain.com/api/v1
CORS_ORIGINS=["https://yourdomain.com"]

# ── RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
NO_ANSWER_THRESHOLD=0.55
SESSION_MEMORY_K=10

# ── Upload / storage
MAX_FILE_MB=50
UPLOAD_DIR=/app/backend/uploads
CHROMA_PERSIST_DIR=/app/backend/chroma_db

# ── Rate limiting
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=3/minute

# ── Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WARM_EMBEDDING_MODEL_ON_STARTUP=true
