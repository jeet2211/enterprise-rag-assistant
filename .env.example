# LLM
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
NO_ANSWER_THRESHOLD=0.55
SESSION_MEMORY_K=10
CHAT_CONTEXT_TOP_K=5
CHAT_CONTEXT_CHUNK_CHARS=1200
CHAT_SYNC_FOLLOWUPS=false
CHAT_LLM_VERIFIER_MIN_CONFIDENCE=low
WARM_EMBEDDING_MODEL_ON_STARTUP=true

# Upload
MAX_FILE_MB=50
UPLOAD_DIR=./backend/uploads

# Storage — PostgreSQL (persistent, cross-device)
CHROMA_PERSIST_DIR=./backend/chroma_db
DATABASE_URL=postgresql://raguser:devpassword@localhost:5432/ragdb
POSTGRES_PASSWORD=devpassword

# Background processing
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# App
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
RATE_LIMIT_CHAT=20/minute

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production URLs
DOMAIN=example.com
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api/v1

# Langfuse (self-hosted LLM observability; optional, blank disables tracing)
# 1. Start Langfuse: docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
# 2. Open http://localhost:3000 and log in with LANGFUSE_INIT_USER_EMAIL / _PASSWORD
# 3. Go to Settings → API Keys → Create key pair → paste values below
# 4. Restart backend: docker compose restart backend worker
LANGFUSE_SECRET_KEY=sk-lf-9f284cc4-0a15-4fcc-9bd4-3984cb0cb50b
LANGFUSE_PUBLIC_KEY=pk-lf-29ad5847-11e6-43b8-ad90-f0e867c28854
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_HOST=http://langfuse-server:3000

# Langfuse internal DB (used by docker-compose.langfuse.yml)
LANGFUSE_DB_PASSWORD=langfuse_dev_password
LANGFUSE_NEXTAUTH_SECRET=change-me-in-prod-use-openssl-rand-hex-32
LANGFUSE_SALT=change-me-in-prod-use-openssl-rand-hex-32
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme123
LANGFUSE_INIT_USER_NAME=Admin 

# Grafana
# Self-hosted Grafana login for the Monitoring page:
#   username: admin
#   password: GRAFANA_PASSWORD
GRAFANA_PASSWORD=changeme
