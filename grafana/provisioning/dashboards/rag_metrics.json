{
  "id": null,
  "uid": "rag-metrics-v1",
  "title": "RAG Assistant Metrics",
  "tags": ["rag", "llm", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total RAG Requests",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rag_requests_total)",
          "legendFormat": "Requests"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Not Found Rate",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rag_not_found_total) / sum(rag_requests_total)",
          "legendFormat": "Refusal rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percentunit",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "red", "value": 0.3 }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ChromaDB Chunks",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rag_chroma_chunk_count",
          "legendFormat": "Chunks"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "User Feedback (Good %)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rag_feedback_total{rating='good'}) / sum(rag_feedback_total)",
          "legendFormat": "Good"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percentunit",
        "thresholds": {
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.75 }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per Minute (by Confidence)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(confidence) (rate(rag_requests_total[2m]) * 60)",
          "legendFormat": "{{confidence}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Answer Confidence Distribution",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(confidence) (rag_requests_total)",
          "legendFormat": "{{confidence}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Answer Style Distribution",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(answer_style) (rag_requests_total)",
          "legendFormat": "{{answer_style}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "End-to-End Latency (P50 / P95 / P99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency Breakdown: Retrieval / LLM / Verifier",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Retrieval P95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "LLM P95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_verifier_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Verifier P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Document Processing (Ready vs Failed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rag_document_processing_total{status='ready'})",
          "legendFormat": "Ready"
        },
        {
          "expr": "sum(rag_document_processing_total{status='failed'})",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "User Feedback Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rag_feedback_total{rating='good'})",
          "legendFormat": "👍 Good"
        },
        {
          "expr": "sum(rag_feedback_total{rating='bad'})",
          "legendFormat": "👎 Bad"
        }
      ]
    }
  ]
}
